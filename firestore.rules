rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isValidNotificacion(data) {
      return data.keys().hasAll(['mensaje', 'enviadoPor', 'fecha']) &&
             data.keys().size() <= 4 &&
             data.mensaje is string && data.mensaje.size() > 0 && data.mensaje.size() <= 1000 &&
             data.enviadoPor is string && data.enviadoPor.size() > 0 && data.enviadoPor.size() <= 200 &&
             (!('link' in data) || data.link == null || (data.link is string && data.link.size() <= 2000)) &&
             data.fecha == request.time;
    }

    function isValidConfiguracionRadio(data) {
      return data.keys().hasAll(['streamingUrl', 'actualizadoPor', 'actualizado']) &&
             data.keys().size() == 3 &&
             data.streamingUrl is string && data.streamingUrl.size() > 0 && data.streamingUrl.size() <= 2000 &&
             data.actualizadoPor is string && data.actualizadoPor.size() > 0 && data.actualizadoPor.size() <= 200 &&
             data.actualizado == request.time;
    }

    function isValidConfiguracionRedes(data) {
      return data.keys().hasAll(['actualizadoPor', 'actualizado']) &&
             data.keys().size() <= 7 &&
             (!('tiktok' in data) || data.tiktok == null || (data.tiktok is string && data.tiktok.size() <= 2000)) &&
             (!('facebook' in data) || data.facebook == null || (data.facebook is string && data.facebook.size() <= 2000)) &&
             (!('youtube' in data) || data.youtube == null || (data.youtube is string && data.youtube.size() <= 2000)) &&
             (!('instagram' in data) || data.instagram == null || (data.instagram is string && data.instagram.size() <= 2000)) &&
             (!('web' in data) || data.web == null || (data.web is string && data.web.size() <= 2000)) &&
             data.actualizadoPor is string && data.actualizadoPor.size() > 0 && data.actualizadoPor.size() <= 200 &&
             data.actualizado == request.time;
    }

    match /notificaciones/{notificacionId} {
      allow read: if isSignedIn(); // Allowed for everyone signed in to see chat
      allow create: if isSignedIn() && isValidId(notificacionId) && isValidNotificacion(incoming());
      allow update, delete: if false; // Not allowed to edit messages for now
    }

    match /config/{configId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(configId) && 
                    (configId == 'radio' ? isValidConfiguracionRadio(incoming()) : 
                     configId == 'redes' ? isValidConfiguracionRedes(incoming()) : false);
      allow update: if isSignedIn() && 
                    (configId == 'radio' ? (isValidConfiguracionRadio(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['streamingUrl', 'actualizadoPor', 'actualizado'])) : 
                     configId == 'redes' ? (isValidConfiguracionRedes(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['tiktok', 'facebook', 'youtube', 'instagram', 'web', 'actualizadoPor', 'actualizado'])) : false);
      allow delete: if false;
    }
  }
}

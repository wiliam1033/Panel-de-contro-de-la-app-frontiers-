{
  "entities": {
    "Notificacion": {
      "title": "Notificacion",
      "description": "Una notificación del chat",
      "type": "object",
      "properties": {
        "mensaje": {
          "type": "string",
          "maxLength": 1000
        },
        "enviadoPor": {
          "type": "string",
          "maxLength": 200
        },
        "link": {
          "type": "string",
          "maxLength": 2000
        },
        "fecha": {
          "type": "string"
        }
      },
      "required": ["mensaje", "enviadoPor", "fecha"]
    },
    "ConfiguracionRadio": {
      "title": "ConfiguracionRadio",
      "description": "Configuración del stream de radio",
      "type": "object",
      "properties": {
        "streamingUrl": {
          "type": "string",
          "maxLength": 2000
        },
        "actualizadoPor": {
          "type": "string",
          "maxLength": 200
        },
        "actualizado": {
          "type": "string"
        }
      },
      "required": ["streamingUrl", "actualizadoPor", "actualizado"]
    },
    "ConfiguracionRedes": {
      "title": "ConfiguracionRedes",
      "description": "Configuración de enlaces a redes sociales y web",
      "type": "object",
      "properties": {
        "tiktok": {
          "type": "string",
          "maxLength": 2000
        },
        "facebook": {
          "type": "string",
          "maxLength": 2000
        },
        "youtube": {
          "type": "string",
          "maxLength": 2000
        },
        "instagram": {
          "type": "string",
          "maxLength": 2000
        },
        "web": {
          "type": "string",
          "maxLength": 2000
        },
        "actualizadoPor": {
          "type": "string",
          "maxLength": 200
        },
        "actualizado": {
          "type": "string"
        }
      },
      "required": ["actualizadoPor", "actualizado"]
    }
  },
  "firestore": {
    "notificaciones/{notificacionId}": {
      "schema": {
        "$ref": "Notificacion"
      },
      "description": "Mensajes y notificaciones del sistema"
    },
    "config/{configId}": {
      "schema": {
        "anyOf": [
          { "$ref": "ConfiguracionRadio" },
          { "$ref": "ConfiguracionRedes" }
        ]
      },
      "description": "Configuraciones globales como la radio y redes sociales"
    }
  }
}
